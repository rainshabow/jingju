# DeepSeek / OpenAI-compatible API
# 获取地址：https://platform.deepseek.com/api_keys
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# PaddleOCR API Token（PDF 文本提取）
# 获取地址：https://www.paddleocr.ai/
PADDLEOCR_TOKEN=your-paddleocr-token-here
# PADDLEOCR_MODEL=PaddleOCR-VL-1.6  # 默认值

# Database path (default: data/jingju.db)
# DB_PATH=data/jingju.db

# Server port (default: 3000)
# PORT=3000
